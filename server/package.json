{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "db:seed": "tsx src/scripts/seed.ts",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:seed": "tsx src/scripts/seed.ts --d1=remote",
    "cf:seed:local": "tsx src/scripts/seed.ts --d1=local",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}
